{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": [
        "public/**",
        "uploads/**",
        "fluffoo.sqlite",
        "src/db/schema.sql",
        "node_modules/sql.js/dist/sql-wasm.wasm"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.js"
    }
  ]
}